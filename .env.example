# ---------------------------------------------------------------------------
# Network selection. Pick one supported network or provide a custom EVM RPC.
# ---------------------------------------------------------------------------
# Either a built-in id: testnet-2 | mainnet
NIBIRU_NETWORK=testnet-2
# ...or explicit values (these override NIBIRU_NETWORK when set):
# NIBIRU_RPC_URL=https://evm-rpc.testnet-2.nibiru.fi
# NIBIRU_CHAIN_ID=6911
# NIBIRU_EXPLORER_URL=https://testnet.nibiscan.io

# ---------------------------------------------------------------------------
# Oracle configuration
# ---------------------------------------------------------------------------
# Nibiru oracle precompile address (same on EVM testnet and mainnet)
NIBIRU_ORACLE_PRECOMPILE=0x0000000000000000000000000000000000000801

# Pairs monitored by the oracle module, in oracle-module pair format
# (base denom : quote denom). Comma separated.
NIBIRU_ORACLE_PAIRS=unibi:uusd,ueth:uusd,ubtc:uusd,uusdc:uusd

# ---------------------------------------------------------------------------
# Independent reference prices
# ---------------------------------------------------------------------------
# Mapping from base denom to canonical market symbol. Comma separated.
REFERENCE_SYMBOLS=unibi=NIBI,ueth=ETH,ubtc=BTC,uusdc=USDC
# Provider order; first provider that quotes a symbol wins.
# Supported: coinbase, kraken, binance, coingecko
REFERENCE_PROVIDERS=coinbase,kraken,binance,coingecko
# Optional CoinGecko demo API key (raises rate limits; all providers work keyless)
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# Monitoring thresholds (used by the integrity analysis)
# ---------------------------------------------------------------------------
# Maximum acceptable oracle update age before a pair is flagged stale, seconds
MAX_ORACLE_AGE_SECONDS=60
# Deviation (in basis points) vs the independent reference that flags
# "warning" and "critical" integrity states.
DEVIATION_WARN_BPS=50
DEVIATION_CRITICAL_BPS=200

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Append-only JSONL store of integrity snapshots (gitignored; regenerated)
STATE_FILE=data/state.jsonl

# ---------------------------------------------------------------------------
# On-chain attestation (optional -- only needed to anchor reports on-chain)
# ---------------------------------------------------------------------------
# Deployed OracleAttestationRegistry address (filled by scripts/deploy.ts)
ATTESTATION_REGISTRY=
# Per-run self-imposed spending guard for the automation account (in NIBI).
# Attestations are refused when the projected gas cost exceeds this value.
MAX_GAS_SPEND_NIBI=0.05
# Optional: private key for a LOW-VALUE testnet automation account only.
# Leave unset for read-only use, tests and dashboard. Never commit this.
# NIBIRU_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_PORT=8787

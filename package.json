{
  "name": "nibiwatch",
  "version": "0.2.0",
  "description": "NibiWatch: independent integrity monitoring and on-chain attestation for the Nibiru native price oracle.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "oracle:read": "tsx src/cli/read-oracle.ts",
    "oracle:probe": "tsx scripts/probe-oracle-paths.ts",
    "monitor:once": "tsx src/cli/monitor-once.ts",
    "monitor:loop": "tsx src/cli/monitor-loop.ts",
    "attest:submit": "tsx src/cli/submit-attestation.ts",
    "contract:compile": "tsx scripts/compile.ts",
    "contract:deploy": "tsx scripts/deploy.ts",
    "contract:verify": "tsx scripts/verify.ts",
    "contract:probe-target": "tsx scripts/probe-evm-target.ts",
    "stats": "node scripts/stats.cjs",
    "secret-scan": "node scripts/secret-scan.cjs",
    "screenshots": "tsx scripts/screenshot.ts",
    "api": "tsx src/server/api.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "test": "vitest run",
    "test:live": "vitest run --mode live",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "6.13.4",
    "express": "^4.21.2",
    "solc": "0.8.37"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}

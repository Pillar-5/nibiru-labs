# Dependencies
node_modules/

# Environment / secrets (NEVER commit)
.env
.env.*
!.env.example
*.key
*.pem

# Build output
dist/
build/

# Runtime data store (regenerated by the monitor; committed samples live in data/samples)
data/state.jsonl
data/store.sqlite

# Contract artifacts are generated by the compile step; committed artifacts are copied to artifacts/
artifacts/*
!artifacts/*.abi.json

# Local logs and tooling caches
*.log
.DS_Store
coverage/
.cache/
node_modules/.vite

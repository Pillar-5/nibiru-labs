# Dependencies
node_modules/

# Environment / secrets (NEVER commit)
.env
.env.*
!.env.example
*.key
*.pem

# Build output
dist/
build/

# Runtime data store (regenerated by the monitor; committed samples live in data/samples)
data/state.jsonl
data/store.sqlite

# Contract artifacts are generated by the compile step (full {abi, bytecode}
# artifact plus the bare ABI copy). The ABI copy is committed so verification
# works without building; the full artifact stays local.
artifacts/*
!artifacts/*.abi.json

# Local logs and tooling caches
*.log
.DS_Store
coverage/
.cache/
node_modules/.vite
